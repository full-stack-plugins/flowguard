{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowGuard controller-frozen specialist sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "context_digest",
    "frozen_digest",
    "pins",
    "digest"
  ],
  "properties": {
    "version": {
      "const": "flowguard.specialist-sources/v1alpha1"
    },
    "context_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "frozen_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "source_snapshot_digest"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_snapshot_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
