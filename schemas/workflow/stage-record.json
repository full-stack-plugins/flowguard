{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowguard.local/schemas/workflow/v1/stage-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "flowguard.workflow/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "stage": {
      "enum": [
        "01-requirements",
        "02-architecture",
        "03-solution",
        "04-testcases",
        "05-hld",
        "06-lld",
        "07-standards",
        "08-review",
        "09-docs",
        "10-release"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      },
      "uniqueItems": true,
      "minItems": 0
    }
  },
  "required": [
    "version",
    "id",
    "stage",
    "owner",
    "source_digest",
    "dependencies"
  ]
}
